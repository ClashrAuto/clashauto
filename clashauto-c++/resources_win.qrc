<RCC>
    <qresource prefix="/">
        <!-- wintun.dll（Windows TUN 驱动，按架构）。仅 Windows 构建内嵌；CoreController 运行时
             按当前架构释放 :/assets/bundle/wintun/<arch>/wintun.dll 到核心 exe 同目录。 -->
        <file>assets/bundle/wintun/x64/wintun.dll</file>
        <file>assets/bundle/wintun/arm64/wintun.dll</file>
        <file>assets/bundle/wintun/x86/wintun.dll</file>
        <file>assets/bundle/wintun/arm/wintun.dll</file>
    </qresource>
</RCC>
